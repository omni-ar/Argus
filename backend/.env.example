# ── Beacon Node ───────────────────────────────────────────────────────────────
# Ethereum Beacon node RPC URL (public Ankr endpoint used by default)
BEACON_URL=https://ethereum-beacon-api.publicnode.com

# Use the checked-in reconciliation snapshot when external API quota is unavailable.
DATA_MODE=snapshot

# ── beaconcha.in API ──────────────────────────────────────────────────────────
# beaconcha.in v1 base URL (used for pubkey → validator index resolution)
BEACONCHAIN_API=https://beaconcha.in/api/v1

# beaconcha.in v2 base URL (used for rewards reconciliation)
BEACONCHAIN_API_V2=https://beaconcha.in/api/v2

# beaconcha.in API key — required for pubkey resolution beyond free-tier limits
# Get yours at https://beaconcha.in/user/settings#api
BEACONCHAIN_API_KEY=your_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
# HTTP port the Express server listens on
PORT=3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Minimum gap (ms) between consecutive outgoing beaconcha.in requests
# Default: 500 ms → ≤2 req/s, well within the free-tier limit
MIN_REQUEST_GAP_MS=500

# ── Pagination ────────────────────────────────────────────────────────────────
# Suggested page size hint for epoch range queries (no hard server cap)
EPOCHS_PAGE_SIZE=50

# ── Redis cache ───────────────────────────────────────────────────────────────
# Redis connection URL. Leave empty to disable caching (every request hits the beacon node).
# When using docker-compose this is set automatically to redis://redis:6379
REDIS_URL=redis://localhost:6379

# TTL (seconds) for cached epoch reward data. Finalized epoch data is immutable,
# so a long TTL is safe. Default: 3600 (1 hour)
CACHE_TTL_SECONDS=3600

# TTL (seconds) for cached validator info (pubkey ↔ index mapping). Default: 3600
VALIDATOR_INFO_CACHE_TTL_SECONDS=3600

# ── Logging ───────────────────────────────────────────────────────────────────
# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ── Tracked validators ────────────────────────────────────────────────────────
# Comma-separated list of validator pubkeys to track.
# If unset, the 5 default pubkeys hard-coded in constants.ts are used.
VALIDATOR_PUBKEYS=0xpubkey1,0xpubkey2,0xpubkey3
